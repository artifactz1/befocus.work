{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "befocus-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // next-themes serializes a function into an inline <script>; wrangler keep_names would inject an undefined __name() into it
  "keep_names": false,
  // keep dashboard-set vars (API_URL) across CI deploys
  "keep_vars": true,
  "observability": { "enabled": true }
  // Runtime vars/secrets (names only, see README "Web App Deployment"):
  //   API_URL  -> set with `bunx wrangler secret put API_URL` (or add to "vars" here)
  // NEXT_PUBLIC_* are inlined at build time, so they must be set in the shell/.env.local that runs `bun run deploy`.
}
